# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/crepe-hekaya?retryWrites=true&w=majority

# JWT signing secret (use a long random string)
JWT_SECRET=your_jwt_secret_key_here_make_it_long_and_random

# Admin credentials (plaintext here — will be hashed on admin-setup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here

# Secret key required to call the admin-setup endpoint
SETUP_SECRET=your_setup_secret_here
