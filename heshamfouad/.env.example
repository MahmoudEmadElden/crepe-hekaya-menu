# MongoDB connection URI (required)
MONGODB_URI=

# JWT secret (required, must be set in production)
JWT_SECRET=

# Admin credentials (required for admin-setup endpoint)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Setup secret used by POST /api/auth/admin-setup (required)
SETUP_SECRET=

# Allowed CORS origins, comma-separated (optional, defaults to same-origin)
ALLOWED_ORIGINS=